# Google Gemini API key (Get one for free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary model name (fast Flash-class model)
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback models tried in order if primary fails or quota is exhausted (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-2.0-flash

# Optional alternative provider ("gemini", "openai_compatible", "ollama")
LLM_PROVIDER=gemini
OPENAI_BASE_URL=
OPENAI_API_KEY=
